@{
    ViewData["isDashboard"] = true;
    var selectedRange = (ViewBag.SelectedRange as string ?? "week").ToLowerInvariant();
    var startDateValue = (ViewBag.StartDate as string) ?? "";
    var endDateValue = (ViewBag.EndDate as string) ?? "";
}

<div class="row mb-3">
    <div class="col-md-8 d-flex align-items-center">
        <div class="btn-group" role="group" aria-label="Range selector">
            <a class="btn btn-outline-light @(selectedRange == "week" ? "active" : "")"
               href="@Url.Action("Index", "Dashboard", new { range = "week" })" title="Last 1 week">1W</a>
            <a class="btn btn-outline-light @(selectedRange == "month" ? "active" : "")"
               href="@Url.Action("Index", "Dashboard", new { range = "month" })" title="Last 1 month">1M</a>
            <a class="btn btn-outline-light @(selectedRange == "3months" ? "active" : "")"
               href="@Url.Action("Index", "Dashboard", new { range = "3months" })" title="Last 3 months">3M</a>
            <a class="btn btn-outline-light @(selectedRange == "6months" ? "active" : "")"
               href="@Url.Action("Index", "Dashboard", new { range = "6months" })" title="Last 6 months">6M</a>
            <a class="btn btn-outline-light @(selectedRange == "year" ? "active" : "")"
               href="@Url.Action("Index", "Dashboard", new { range = "year" })" title="Last 1 year">1Y</a>
        </div>

        @* Save-As Export PDF button: uses File System Access API with a download fallback *@
        <button id="exportPdfBtn" type="button" class="btn btn-sm btn-success ms-3"
                title="Export report for the selected range">
            <i class="fa-solid fa-file-pdf me-1"></i> Save As...
        </button>
    </div>

    @* Custom date range inputs (GET form) *@
    <div class="col-md-4">
        <form class="d-flex justify-content-end" method="get" action="@Url.Action("Index", "Dashboard")">
            <div class="input-group">
                <input id="startDateInput" class="form-control form-control-sm" type="date" name="startDate" value="@startDateValue" />
                <input id="endDateInput" class="form-control form-control-sm" type="date" name="endDate" value="@endDateValue" />
                <button class="btn btn-sm btn-primary" type="submit">Apply</button>
                <a class="btn btn-sm btn-outline-light" href="@Url.Action("Index", "Dashboard", new { range = "week" })" title="Reset">Reset</a>
            </div>
        </form>
    </div>
</div>

@*Summary Widgets*@
<div class="row mb-4">

    <div class="col-md-4">
        <div class="d-flex flex-row widget summary income">
            <div class="d-flex flex-column justify-content-center p-5">
                <i class="fa-solid fa-dollar-sign fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3">
                <span class="lead">Total Income</span>
                <h1 class="display-6 fw-bold">@ViewBag.TotalIncome</h1>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="d-flex flex-row widget summary expense">
            <div class="d-flex flex-column justify-content-center p-5">
                <i class="fa-solid fa-dollar-sign fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3">
                <span class="lead">Total Expense</span>
                <h1 class="display-6 fw-bold">@ViewBag.TotalExpense</h1>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="d-flex flex-row widget summary balance">
            <div class="d-flex flex-column justify-content-center p-5">
                <i class="fa-solid fa-dollar-sign fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3">
                <span class="lead">Balance</span>
                <h1 class="display-6 fw-bold">@ViewBag.Balance</h1>
            </div>
        </div>
    </div>
</div>


@*Doughnut and Spline Chart*@
<div class="row mb-4">
    <div class="col-md-4">
        <div class="widget chart">
            <div class="p-4">
                <h5 class="fw-bold">Expense By Category</h5>
            </div>
            <ejs-accumulationchart id="doughnutchart" enableSmartLabels background="#1a222b">
                <e-accumulation-series-collection>
                    <e-accumulation-series dataSource="@ViewBag.DoughnutChartData"
                                           xName="categoryTitleWithIcon" yName="amount"
                                           innerRadius="60%" legendShape="Circle"
                                           palettes=@(new string[] { "#0e8d76", "#a4b219", "#cb9b00", "#8a442c", "#0454b5", "#7d0a0a", "#822690", "#4c2090", "#313e93", "#0096ac" })>
                        <e-accumulationseries-datalabel name="formattedAmount" visible></e-accumulationseries-datalabel>
                    </e-accumulation-series>
                </e-accumulation-series-collection>
                <e-accumulationchart-legendsettings position="Top" toggleVisibility="false">
                    <e-legendsettings-textstyle color="#fff" size="1rem"></e-legendsettings-textstyle>
                </e-accumulationchart-legendsettings>
                <e-accumulationchart-tooltipsettings enable></e-accumulationchart-tooltipsettings>
            </ejs-accumulationchart>
        </div>
    </div>
    <div class="col-md-8">
        <div class="widget chart">
            <div class="p-4">
                <h5 class="fw-bold">Income vs Expense</h5>
            </div>
            <ejs-chart id="spline-chart" background="#1a222b"
                       palettes=@(new string[]{"#54ffa9","#ffe91a"})>
                <e-chart-primaryxaxis valueType="Category">
                    <e-majorgridlines width="0"></e-majorgridlines>
                    <e-majorticklines width="0"></e-majorticklines>
                </e-chart-primaryxaxis>
                <e-chart-primaryyaxis>
                    <e-majorgridlines width="1" color="#32414d" dashArray="3,5"></e-majorgridlines>
                    <e-majorticklines width="0"></e-majorticklines>
                    <e-linestyle width="0"></e-linestyle>
                </e-chart-primaryyaxis>
                <e-chart-chartarea>
                    <e-chartarea-border width="0"></e-chartarea-border>
                </e-chart-chartarea>
                <e-series-collection>
                    <e-series dataSource="@ViewBag.SplineChartData" xName="day" width="3"
                              yName="income" name="Income" type="@Syncfusion.EJ2.Charts.ChartSeriesType.Spline"></e-series>
                    <e-series dataSource="@ViewBag.SplineChartData" xName="day" width="3"
                              yName="expense" name="Expense" type="@Syncfusion.EJ2.Charts.ChartSeriesType.Spline"></e-series>
                </e-series-collection>
                <e-chart-legendsettings position="Top" alignment="Center" toggleVisibility="false">
                    <e-legendsettings-textstyle color="#fff" size="1rem"></e-legendsettings-textstyle>
                </e-chart-legendsettings>
                <e-chart-tooltipsettings enable shared></e-chart-tooltipsettings>
            </ejs-chart>
        </div>
    </div>
</div>



@*Recent Transactions and More*@
<div class="row">
    <div class="col-md-6">
        <div class="widget">
            <div class="p-4">
                <h5 class="fw-bold">Recent Transactions</h5>
            </div>
            <div class="px-4 pb-4">
                <ejs-grid id="recent-transactions"
                          dataSource="@ViewBag.RecentTransactions" gridLines="None">
                    <e-grid-columns>
                        <e-grid-column headerText="Category" field="CategoryTitleWithIcon"></e-grid-column>
                        <e-grid-column headerText="Date" field="Date" type="date" format="MMM-dd-yy"></e-grid-column>
                        <e-grid-column headerText="Amount" field="FormattedAmount" textAlign="Right"></e-grid-column>
                    </e-grid-columns>
                </ejs-grid>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="widget h-100">
            <div class="d-flex justify-content-center align-items-center h-100">
                <span><i class="fa-solid fa-plus fa-2xl"></i> Widget</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Called when user clicks "Save As..." to let them pick a save location
        async function savePdfForSelection(range, startDate, endDate) {
            try {
                const params = new URLSearchParams();
                if (range) params.set('range', range);
                if (startDate) params.set('startDate', startDate);
                if (endDate) params.set('endDate', endDate);

                const url = '/Report/GeneratePdf?' + params.toString();
                const resp = await fetch(url, { credentials: 'same-origin' });
                if (!resp.ok) {
                    alert('Failed to generate PDF: ' + resp.statusText);
                    return;
                }

                const blob = await resp.blob();
                const now = new Date();
                const fileNameParts = ['ExpenseReport', range || 'custom'];
                if (startDate) fileNameParts.push(startDate);
                if (endDate) fileNameParts.push(endDate);
                const suggestedName = fileNameParts.join('_') + '.pdf';

                // File System Access API (Chromium-based browsers)
                if (window.showSaveFilePicker) {
                    const opts = {
                        suggestedName,
                        types: [{
                            description: 'PDF Document',
                            accept: { 'application/pdf': ['.pdf'] }
                        }]
                    };
                    const handle = await window.showSaveFilePicker(opts);
                    const writable = await handle.createWritable();
                    await writable.write(blob);
                    await writable.close();
                } else {
                    // Fallback: create an object URL and use anchor download - respects user's browser download settings
                    const link = document.createElement('a');
                    const urlObj = URL.createObjectURL(blob);
                    link.href = urlObj;
                    link.download = suggestedName;
                    document.body.appendChild(link);
                    link.click();
                    link.remove();
                    setTimeout(() => URL.revokeObjectURL(urlObj), 1000);
                }
            } catch (ex) {
                console.error(ex);
                alert('Error saving PDF: ' + (ex.message || ex));
            }
        }

        document.getElementById('exportPdfBtn').addEventListener('click', function () {
            const range = '@selectedRange';
            // prefer inputs (custom dates) if present
            const startDate = document.getElementById('startDateInput').value || '';
            const endDate = document.getElementById('endDateInput').value || '';
            savePdfForSelection(range, startDate, endDate);
        });
    </script>
}
